# What never needs to reach the Docker daemon. This shrinks the build context,
# which is uploaded in full on every build — .git/ in particular grows forever
# and is read by nothing in the Dockerfile.
target/
.git/
.github/
.idea/
*.iml

# The published documentation page. 40 KB of HTML that the build has no use for.
docs/
node_modules/
package.json
package-lock.json
release.config.mjs
commitlint.config.mjs
CHANGELOG.md
